{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "composite": true
  },
  "include": ["electron.vite.config.ts", "electron.vite.messages.ts", "vitest.config.ts", "src/main/**/*", "src/preload/**/*", "src/ptyhost/**/*", "src/sshcore/**/*", "src/sftphost/**/*", "src/updatesplash/**/*", "src/shared/**/*", "test/**/*"]
}
