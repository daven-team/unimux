{
  "name": "unimux",
  "productName": "unimux",
  "version": "1.0.8",
  "description": "Mission control for your AI coding agents. Run a wall of Claude Code and Codex terminals side by side, get pinged when one needs you, pick up any conversation after a restart, and commit, edit and review without leaving the grid. Windows and macOS.",
  "author": "ajzak, azozowsky",
  "contributors": [
    "ajzak",
    "azozowsky"
  ],
  "license": "MIT",
  "homepage": "https://github.com/daven-team/unimux",
  "repository": {
    "type": "git",
    "url": "https://github.com/daven-team/unimux.git"
  },
  "bugs": "https://github.com/daven-team/unimux/issues",
  "keywords": [
    "claude-code",
    "codex",
    "terminal",
    "ai-agents",
    "electron",
    "windows",
    "macos",
    "xterm",
    "multi-agent"
  ],
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/patch-node-pty.cjs && node scripts/fix-pty-permissions.cjs",
    "icons": "node scripts/render-icon.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:automation": "npm run build && node scripts/smoke-automation.mjs",
    "test:mcp": "vitest run test/mcp test/hook-fallback && node scripts/verify-mcp-cli.mjs",
    "test:mcp-app": "npm run build && node scripts/verify-mcp-app.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never -c.npmRebuild=true",
    "test:packaged": "node scripts/smoke-pty.mjs",
    "test:start": "node scripts/smoke-start.mjs",
    "test:ssh-electron": "node scripts/smoke-ssh.mjs",
    "perf": "node scripts/perf-profile.mjs",
    "publish-release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "electron-updater": "^6.8.9",
    "ioredis": "6.0.0",
    "mysql2": "3.24.6",
    "node-pty": "^1.1.0",
    "pg": "8.23.1",
    "pg-cursor": "2.22.1",
    "ssh2": "1.17.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/pg-cursor": "2.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "hyparquet": "^1.31.4",
    "hyparquet-compressors": "^1.1.2",
    "js-yaml": "4.3.2",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.unimux.app",
    "productName": "unimux",
    "asar": false,
    "npmRebuild": false,
    "afterPack": "scripts/fix-pty-permissions.cjs",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json",
      "!resources/branding/**",
      "!**/*.pdb",
      "!**/*.map",
      "!**/node_modules/**/*.{ts,cts,mts}",
      "!**/node_modules/**/*.md",
      "!**/node_modules/@modelcontextprotocol/sdk/dist/esm/**",
      "!**/node_modules/zod/**/*.js",
      "!**/node_modules/node-addon-api/**",
      "!**/node_modules/node-pty/{third_party,deps,src,scripts,build}/**",
      "!**/node_modules/node-pty/binding.gyp",
      "!**/node_modules/node-pty/lib/**/*.test.js",
      "!**/node_modules/cpu-features/**",
      "!**/node_modules/nan/**",
      "!**/node_modules/ssh2/lib/protocol/crypto/build/**",
      "!**/node_modules/ssh2/lib/protocol/crypto/src/**",
      "!**/node_modules/ssh2/lib/protocol/crypto/binding.gyp",
      "!**/node_modules/ssh2/install.js",
      "!**/node_modules/ssh2/test/**",
      "!**/node_modules/ssh2/examples/**",
      "!**/node_modules/ssh2/util/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "electronLanguages": [
        "en-US",
        "pl",
        "de",
        "es",
        "fr",
        "pt-BR"
      ],
      "files": [
        "out/**",
        "resources/**",
        "package.json",
        "!resources/branding/**",
        "!**/*.pdb",
        "!**/*.map",
        "!**/node_modules/**/*.{ts,cts,mts}",
        "!**/node_modules/**/*.md",
        "!**/node_modules/@modelcontextprotocol/sdk/dist/esm/**",
        "!**/node_modules/zod/**/*.js",
        "!**/node_modules/node-addon-api/**",
        "!**/node_modules/node-pty/{third_party,deps,src,scripts,build}/**",
        "!**/node_modules/node-pty/binding.gyp",
        "!**/node_modules/node-pty/lib/**/*.test.js",
        "!**/node_modules/cpu-features/**",
        "!**/node_modules/nan/**",
        "!**/node_modules/ssh2/lib/protocol/crypto/build/**",
        "!**/node_modules/ssh2/lib/protocol/crypto/src/**",
        "!**/node_modules/ssh2/lib/protocol/crypto/binding.gyp",
        "!**/node_modules/ssh2/install.js",
        "!**/node_modules/ssh2/test/**",
        "!**/node_modules/ssh2/examples/**",
        "!**/node_modules/ssh2/util/**",
        "!**/node_modules/node-pty/prebuilds/darwin-*/**",
        "!**/node_modules/node-pty/prebuilds/win32-arm64/**"
      ],
      "asar": true,
      "asarUnpack": [
        "**/node_modules/node-pty/**"
      ]
    },
    "nsis": {
      "guid": "214279c4-b798-5d4e-848f-0b9245114cd1",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "unimux",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "appId": "com.ajzakomator.app",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.png",
      "electronLanguages": [
        "en-US",
        "pl",
        "de",
        "es",
        "fr",
        "pt-BR"
      ],
      "files": [
        "out/**",
        "resources/**",
        "package.json",
        "!resources/branding/**",
        "!**/*.pdb",
        "!**/*.map",
        "!**/node_modules/**/*.{ts,cts,mts}",
        "!**/node_modules/**/*.md",
        "!**/node_modules/@modelcontextprotocol/sdk/dist/esm/**",
        "!**/node_modules/zod/**/*.js",
        "!**/node_modules/node-addon-api/**",
        "!**/node_modules/node-pty/{third_party,deps,src,scripts,build}/**",
        "!**/node_modules/node-pty/binding.gyp",
        "!**/node_modules/node-pty/lib/**/*.test.js",
        "!**/node_modules/cpu-features/**",
        "!**/node_modules/nan/**",
        "!**/node_modules/ssh2/lib/protocol/crypto/build/**",
        "!**/node_modules/ssh2/lib/protocol/crypto/src/**",
        "!**/node_modules/ssh2/lib/protocol/crypto/binding.gyp",
        "!**/node_modules/ssh2/install.js",
        "!**/node_modules/ssh2/test/**",
        "!**/node_modules/ssh2/examples/**",
        "!**/node_modules/ssh2/util/**",
        "!**/node_modules/node-pty/prebuilds/win32-*/**"
      ],
      "identity": "-",
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "daven-team",
        "repo": "unimux"
      }
    ]
  },
  "private": true
}
