{
  "name": "unimux",
  "productName": "unimux",
  "version": "1.2.0",
  "description": "Mission control for your AI coding agents. Run a wall of Claude Code and Codex terminals side by side, get pinged when one needs you, pick up any conversation after a restart, and commit, edit and review without leaving the grid. Windows and macOS.",
  "author": "ajzak, azozowsky",
  "contributors": [
    "ajzak",
    "azozowsky"
  ],
  "license": "MIT",
  "homepage": "https://github.com/daven-team/unimux",
  "repository": {
    "type": "git",
    "url": "https://github.com/daven-team/unimux.git"
  },
  "bugs": "https://github.com/daven-team/unimux/issues",
  "keywords": [
    "claude-code",
    "codex",
    "terminal",
    "ai-agents",
    "tauri",
    "windows",
    "macos",
    "xterm",
    "multi-agent"
  ],
  "scripts": {
    "dev": "node scripts/msvc-run.mjs tauri dev",
    "build": "node scripts/msvc-run.mjs tauri build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "tauri": "node scripts/msvc-run.mjs tauri",
    "dev:ui": "vite --config vite.config.tauri.ts",
    "build:ui": "vite build --config vite.config.tauri.ts",
    "build:check": "node scripts/msvc-run.mjs --target-dir=check tauri build --no-bundle --features dev-overrides,test-bridge",
    "build:release": "node scripts/msvc-run.mjs tauri build",
    "check:bundle": "node scripts/check-bundle-contents.mjs",
    "cargo": "node scripts/msvc-run.mjs cargo",
    "gen:contract": "node scripts/gen-ipc-contract.mjs",
    "gen:messages": "node scripts/gen-messages.mjs",
    "gen:goldens": "node scripts/dump-goldens.mjs",
    "gen:check": "node scripts/gen-ipc-contract.mjs --check && node scripts/gen-messages.mjs --check && node scripts/dump-goldens.mjs --check",
    "ipc:report": "node scripts/ipc-report.mjs",
    "porting:count": "node scripts/porting-count.mjs",
    "smoke:tauri": "node scripts/smoke-tauri.mjs",
    "verify:caption": "node scripts/verify-caption.mjs",
    "smoke:eval-bridge": "node scripts/smoke-eval-bridge.mjs",
    "test:automation": "npm run build:check && node scripts/smoke-automation.mjs",
    "test:mcp": "node scripts/verify-mcp-cli.mjs",
    "test:mcp-app": "npm run build:check && node scripts/verify-mcp-app.mjs",
    "test:start": "node scripts/smoke-start.mjs --install --ci",
    "perf": "node scripts/perf-profile.mjs",
    "publish-release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.2.18",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/cli": "~2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "ioredis": "6.0.0",
    "js-yaml": "5.5.0",
    "marked": "^18.1.3",
    "mysql2": "3.24.6",
    "proper-lockfile": "4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "1.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "zod": "4.6.7",
    "zustand": "^5.0.16"
  },
  "private": true
}
