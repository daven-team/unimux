{
  "tools": [
    {
      "name": "get_context",
      "description": "Your cell ID, role, project, grid, cwd, paused flag and inbox counts (open tasks, unread messages). profiles:true adds profile IDs for create_grid/update_agent.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "profiles": {
            "type": "boolean"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "list_agents",
      "description": "Agents in your project: cell ID, name, role, status, since (seconds in that status), mcp (connected|waiting|off), open task count, plus grids. verbose adds profile/model/cwd/open task titles/lastExitCode.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "verbose": {
            "type": "boolean"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "read_inbox",
      "description": "Your open tasks and unread messages in one call. A task prompt already shown to you is left out (seen:true; full:true repeats it). acknowledge:true marks the returned messages read. Use at task start/end; to idle use wait_for, not polling.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "acknowledge": {
            "type": "boolean",
            "description": "mark returned messages read (clipped ones stay unread)"
          },
          "closed": {
            "type": "boolean",
            "description": "include completed/cancelled tasks"
          },
          "full": {
            "type": "boolean",
            "description": "no truncation, repeat prompts already shown"
          },
          "limit": {
            "type": "integer",
            "description": "default 20"
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "wait_for",
      "description": "Block instead of polling. Without taskIds: returns when you get an unread message or a startable task. With taskIds (open tasks): returns when any (all:true: every) is completed/blocked/cancelled, or with event \"exited\"/\"stalled\" naming agents of watched tasks that stopped or never got going (each told once). \"timeout\": nothing happened.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "open task IDs to watch"
          },
          "all": {
            "type": "boolean"
          },
          "timeoutSec": {
            "type": "integer",
            "description": "default 60; max 600 s for Claude, 170 s for Codex"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "optional"
      }
    },
    {
      "name": "update_task",
      "description": "Report on or manage a task: in_progress, blocked (blockedReason), completed (result.summary required) or cancelled; cellId instead moves a queued task to another agent (a cancelled one becomes a new task there). Closed tasks cannot be reopened.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "blocked",
              "completed",
              "cancelled"
            ]
          },
          "cellId": {
            "type": "string",
            "description": "reassign to this agent"
          },
          "blockedReason": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "description": "what was done"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "changed files"
              },
              "tests": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "tests run and outcome"
              },
              "branch": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              }
            },
            "required": [
              "summary"
            ]
          }
        },
        "required": [
          "taskId"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "send_message",
      "description": "Send text to another agent in your project (its inbox; it is told with a short notice when it sits idle).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "toCellId": {
            "type": "string",
            "description": "cell ID (an exact agent name also works)"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "toCellId",
          "text"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "create_task",
      "description": "Coordinator: assign a tracked task to a cell. dependsOn (task IDs) keeps it blocked until they complete. Delivery is not completion; wait_for the result.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cellId": {
            "type": "string",
            "description": "cell ID (an exact agent name also works)"
          },
          "title": {
            "type": "string"
          },
          "prompt": {
            "type": "string",
            "description": "full instructions"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "prerequisite task IDs"
          }
        },
        "required": [
          "cellId",
          "title",
          "prompt"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "get_tasks",
      "description": "Coordinator: project tasks as compact rows (id, cell, title, status, blockedBy, result summary). Filters cellId/status/readyOnly/ids; verbose adds prompts and full results; next = offset of the next page.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cellId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "in_progress",
              "blocked",
              "completed",
              "cancelled"
            ]
          },
          "readyOnly": {
            "type": "boolean",
            "description": "startable queued only"
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verbose": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "description": "default 25"
          },
          "offset": {
            "type": "integer"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "snippets",
      "description": "Prompt library. action list (default): snippet IDs/names and team presets; get: text of snippetId; save: create/update {name,text,snippetId?,autoSend?}; apply: assign snippetId to cellId as a task.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "get",
              "save",
              "apply"
            ]
          },
          "snippetId": {
            "type": "string"
          },
          "cellId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "autoSend": {
            "type": "boolean",
            "description": "paste and submit"
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "update_agent",
      "description": "Change name, color, profileId or model of an agent (default: yourself; others: coordinator). Empty string clears color/model. Launch changes apply at next start (needsRestart); restart:true requests a safe restart.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cellId": {
            "type": "string",
            "description": "default: yourself"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "description": "#rrggbb"
          },
          "profileId": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "CLI model id"
          },
          "restart": {
            "type": "boolean"
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "create_grid",
      "description": "Coordinator: start a whole team in ONE call; follow your delegation rules (spends usage). name + cells (or presetId); gridId appends. profileId: claude|codex. role makes prompt a tracked task; count repeats; after chains tasks. Returns cellIds, tasks {cellId:taskId} for wait_for. Max 20 cells. help grids.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "new grid name"
          },
          "gridId": {
            "type": "string",
            "description": "append to this grid instead"
          },
          "presetId": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "cells per row, e.g. [2,2]"
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "profileId": {
                  "type": "string",
                  "description": "claude | codex | other id"
                },
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "coordinator",
                    "worker"
                  ]
                },
                "color": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "prompt": {
                  "type": "string",
                  "description": "startup task"
                },
                "worktree": {
                  "type": "boolean",
                  "description": "isolated git worktree"
                },
                "count": {
                  "type": "integer",
                  "description": "repeat this cell N times (names get \" 1\", \" 2\", ...)"
                },
                "after": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "description": "positions (0-based, after count expansion) of earlier cells whose tasks must complete first"
                }
              },
              "required": [
                "profileId"
              ]
            }
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "close_grid",
      "description": "Coordinator: stop a finished grid's agents and archive it (not your own grid). cancelTasks:true if tasks are unfinished.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "gridId": {
            "type": "string"
          },
          "cancelTasks": {
            "type": "boolean"
          }
        },
        "required": [
          "gridId"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "update_grid",
      "description": "Coordinator: rename a grid.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "gridId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "gridId",
          "name"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "save_preset",
      "description": "Coordinator: save a reusable team preset; cells are the same objects as in create_grid.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {}
            },
            "description": "as create_grid cells"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "required": [
          "name",
          "cells"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "help",
      "description": "Longer guidance on demand. topic: workflow, tasks, grids, snippets, limits (default workflow).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "workflow",
              "tasks",
              "grids",
              "snippets",
              "limits"
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    }
  ],
