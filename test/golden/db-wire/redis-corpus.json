{
  "about": "SP9: console commands run through the 1.1.4 DB host (ioredis 6.0, callBuffer, RESP2) and by the Rust spike readers; argv items are RedisData (a string, or {b64}). The setup runs first on DB 0. test/db-wire-sp9.int.test.ts writes the goldens, src-tauri/crates/unimux-db/tests/wire_servers.rs compares.",
  "setup": [
    ["FLUSHDB"],
    ["SET", "s", "hello"],
    ["SET", "bin", { "b64": "/wD+" }],
    ["SET", "utf", "ąę😀"],
    ["SET", "big", "123456789012345678901234567890"],
    ["RPUSH", "l", "a", "", "c"],
    ["HSET", "h", "f1", "v1", "f2", { "b64": "gA==" }],
    ["SADD", "set", "only"],
    ["ZADD", "z", "1.5", "m1", "-inf", "m0"],
    ["XADD", "st", "1-1", "k", "v"],
    ["ACL", "SETUSER", "sp9", "on", ">pw", "~*", "&*", "+@all"]
  ],
  "commands": [
    { "id": "ping", "argv": ["PING"] },
    { "id": "ping_msg", "argv": ["PING", "hi"] },
    { "id": "get", "argv": ["GET", "s"] },
    { "id": "get_bin", "argv": ["GET", "bin"] },
    { "id": "get_utf", "argv": ["GET", "utf"] },
    { "id": "get_missing", "argv": ["GET", "nope"] },
    { "id": "strlen", "argv": ["STRLEN", "utf"] },
    { "id": "incr_big", "argv": ["INCRBY", "counter", "9223372036854775806"] },
    { "id": "decr", "argv": ["DECRBY", "neg", "5"] },
    { "id": "type", "argv": ["TYPE", "l"] },
    { "id": "lrange", "argv": ["LRANGE", "l", "0", "-1"] },
    { "id": "hgetall", "argv": ["HGETALL", "h"] },
    { "id": "smembers", "argv": ["SMEMBERS", "set"] },
    { "id": "zrange", "argv": ["ZRANGE", "z", "0", "-1", "WITHSCORES"] },
    { "id": "xrange", "argv": ["XRANGE", "st", "-", "+"] },
    { "id": "mget", "argv": ["MGET", "s", "nope", "bin"] },
    { "id": "exists", "argv": ["EXISTS", "s", "nope"] },
    { "id": "set_ok", "argv": ["SET", "w", "1"] },
    { "id": "object_encoding", "argv": ["OBJECT", "ENCODING", "l"] },
    { "id": "wrongtype", "argv": ["LPUSH", "s", "x"] },
    { "id": "unknown", "argv": ["NOPECMD", "a"] },
    { "id": "arity", "argv": ["GET"] },
    { "id": "eval_nested", "argv": ["EVAL", "return {1, 'two', {3, {'four'}}, false, -5}", "0"] },
    { "id": "eval_status", "argv": ["EVAL", "return redis.status_reply('FINE')", "0"] },
    { "id": "eval_error", "argv": ["EVAL", "return redis.error_reply('MYERR custom text')", "0"] },
    { "id": "eval_error_nospace", "argv": ["EVAL", "return redis.error_reply('nospace')", "0"] },
    { "id": "eval_error_in_array", "argv": ["EVAL", "return {1, redis.error_reply('ERR inner'), 2}", "0"] },
    { "id": "eval_status_bytes", "argv": ["EVAL", "return redis.status_reply(ARGV[1])", "0", { "b64": "/w==" }] },
    { "id": "eval_error_bytes", "argv": ["EVAL", "return redis.error_reply(ARGV[1])", "0", { "b64": "RVJSIP8=" }] },
    { "id": "eval_float", "argv": ["EVAL", "return 3.99", "0"] },
    { "id": "eval_empty", "argv": ["EVAL", "return {}", "0"] },
    { "id": "big_value", "argv": ["EVAL", "return string.rep('x', 1048580)", "0"] },
    { "id": "big_value_utf8_cut", "argv": ["EVAL", "return string.rep('x', 1048575) .. 'ą'", "0"] },
    { "id": "info_server_head", "argv": ["EVAL", "return string.sub(redis.call('INFO', 'server'), 1, 9)", "0"] },
    { "id": "config_get", "argv": ["CONFIG", "GET", "maxmemory-policy"] },
    { "id": "client_getname", "argv": ["CLIENT", "GETNAME"] },
    { "id": "dbsize_after", "argv": ["EXISTS", "w"] }
  ]
}
